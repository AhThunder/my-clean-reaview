{
  "manifest_version": 3,
  "name": "MyCleanReview",
  "version": "1.1.0",
  "description": "쿠팡 상품 리뷰를 사용자의 설정에 맞게 추출하여 LLM을 활용해 스마트하게 요약합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "MyCleanReview"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.coupang.com/vp/products/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "crypto_util.js",
        "encrypted_secret.js",
        "sample_data.js",
        "utils.js",
        "gemini.js",
        "icons/*"
      ],
      "matches": [
        "*://*.coupang.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.coupang.com/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}